{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Exemplo de hooks do OpenCode configurados globalmente. Autocontidos em hooks/. Ajuste os caminhos conforme seu ambiente.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_end.py",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/validate_sensitive_write.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/validate_bash_command.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_end.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_start.py",
            "timeout": 1
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/notification_handler.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/subagent_start.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/subagent_stop.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "_notes": {
    "security": "Nunca commitar caminhos absolutos ou segredos. Substitua <hooks> pelo caminho real.",
    "updated": "2026-10-28",
    "origin": "Dispositivo Cesar (Windows)"
  }
}