{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Configuracao global de hooks do OpenCode + motion-lab (ver motion-lab/).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_start.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/motion-lab/motion_session_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_end.py",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/validate_sensitive_write.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python <hooks>/reasoning/skill-quality-gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python <hooks>/motion-lab/pre_write_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/validate_bash_command.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_end.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "skill|Skill|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/reasoning/skill-evolver-hook.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/motion-lab/post_render_qa.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/session_start.py",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "python <hooks>/reasoning/assumption-probe.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python <hooks>/reasoning/bias-tracker.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/motion-lab/motion_prompt_router.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/notification_handler.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/subagent_start.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/subagent_stop.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <hooks>/motion-lab/stop_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "_notes": {
    "security": "Nunca commitar caminhos absolutos ou segredos. Substitua <hooks> pelo caminho real.",
    "updated": "2026-11-09",
    "origin": "skill-evolver + motion-lab (motion hooks appended; ver motion-lab/)"
  }
}