  "trilha": "nenhuma",
  "precisa": ["rosto", "prints-reais", "boca (rastrear-boca.py)"],
  "motor_embutido": {"modelo": "modelo/ (copiar para <P>/motor e seguir modelo/README.md)", "kit": "modelo/kit/ (intocado)", "exemplo": "modelo/exemplo/ (referência aprovada, remonta idêntica)"},
